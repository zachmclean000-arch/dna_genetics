PORT=3001
# Comma-separated frontend origins allowed to submit through the development proxy.
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DB_CLIENT=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=dna_genetics
PGUSER=postgres
# Enter your local PostgreSQL password inside the quotes in backend/.env.
PGPASSWORD=""
# Optional alternative to PG* settings:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/dna_genetics
# SQLite is only used when explicitly setting DB_CLIENT=sqlite, or in isolated tests.
# Set these only while running npm run create-admin -w backend
# ADMIN_EMAIL=teacher@example.test
# ADMIN_PASSWORD=choose-a-unique-password
# Gmail account used to send order notifications. Use a Google app password,
# never the account's normal password. Keep these values only in backend/.env.
# SMTP_USER=sender@gmail.com
# SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ORDER_NOTIFICATION_EMAIL=talebrio8@gmail.com
